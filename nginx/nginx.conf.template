split_clients "${remote_addr}${request_uri}" $backend_host {
    95% ${V1_HOST};
    5%  ${V2_HOST};
}

server {
    listen ${PORT};

    resolver 1.1.1.1 8.8.8.8 valid=300s;

    location / {
        proxy_ssl_server_name on;
        proxy_ssl_name $backend_host;

        proxy_set_header Host $backend_host;
        proxy_pass ${PROXY_SCHEME}://$backend_host;
    }
}
